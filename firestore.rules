rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // グローバルセーフティネット（未定義パスへのアクセス拒否）
    match /{document=**} {
      allow read, write: if false;
    }

    // 役員共有ドキュメント（保育園プレゼント集金割り勘）
    match /collections/{docId} {
      allow read: if docId == 'main';
      allow write: if docId == 'main'
        && request.resource.data.teachers is list
        && request.resource.data.participants is list;
    }

    match /warikan/{docId} {
      allow read: if docId == 'main';
      allow write: if docId == 'main'
        && request.resource.data.teachers is list
        && request.resource.data.participants is list;
    }
  }
}
